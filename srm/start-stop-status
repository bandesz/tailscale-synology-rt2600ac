#!/bin/sh
# Package Center calls this. On SRM 1.3.2 (BusyBox ps, RT2600ac) "ps aux"
# is an error and "ps w" is what lists the full command line.
set -eu

PKGDEST="${SYNOPKG_PKGDEST}"
# Outside target/, so a package upgrade does not replace it. The tailscale
# binary looks for its socket here when it is not running on DSM 6.
STATE_DIR="${SYNOPKG_PKGVAR:-/var/packages/${SYNOPKG_PKGNAME}/var}"
LOG="${STATE_DIR}/tailscaled.stdout.log"
BIN="${PKGDEST}/bin/tailscaled"
STATE_FILE="${STATE_DIR}/tailscaled.state"
SOCKET_FILE="${STATE_DIR}/tailscaled.sock"
# Apache on SRM serves this tree. Static files follow a symlink, but CGI is
# executed only from a real file here. DSM's nginx does the symlink itself.
UI_ROOT="${UI_ROOT:-/usr/syno/synoman/webman/3rdparty}"
UI_LINK="${UI_ROOT}/${SYNOPKG_PKGNAME}"

note() {
    printf '%s\n' "$1" >>"${SYNOPKG_TEMP_LOGFILE:-/dev/null}"
}

# pgrep is not installed on SRM. Which ps lists every process, and which
# column is the pid, was measured on SRM 1.3.2 BusyBox (RT2600ac): "ps aux"
# is an error there, and "ps" without "w" truncates the command line.
if ps aux >/dev/null 2>&1; then
    PS_CMD="ps aux"
    PS_COL=2
elif ps w >/dev/null 2>&1; then
    PS_CMD="ps w"
    PS_COL=1
else
    PS_CMD="ps"
    PS_COL=1
fi

pids() {
    # shellcheck disable=SC2009
    ${PS_CMD} 2>/dev/null | grep "${BIN}" | grep -v grep | awk -v col="${PS_COL}" '{print $col}' || true
}

ensure_tun() {
    ko=""
    for candidate in \
        /lib/modules/tun.ko \
        "/lib/modules/$(uname -r)/tun.ko" \
        "/lib/modules/$(uname -r)/kernel/drivers/net/tun.ko"
    do
        if [ -f "${candidate}" ]; then
            ko="${candidate}"
            break
        fi
    done
    if [ -n "${ko}" ]; then
        if ! lsmod 2>/dev/null | grep -q '^tun'; then
            insmod "${ko}" >/dev/null 2>&1 || true
        fi
    fi
    if [ ! -d /dev/net ]; then
        mkdir -m 755 /dev/net
    fi
    if [ ! -c /dev/net/tun ]; then
        mknod /dev/net/tun c 10 200
    fi
    chmod 666 /dev/net/tun
}

start_daemon() {
    mkdir -p "${STATE_DIR}"
    if ! ensure_tun 2>>"${LOG}"; then
        note "Could not create /dev/net/tun. See ${LOG}."
        return 1
    fi
    printf '%s\n' "$(date) starting ${BIN} --tun=tailscale0" >>"${LOG}"
    # New session, so Package Center exiting this script does not deliver SIGHUP.
    if command -v setsid >/dev/null 2>&1; then
        setsid "${BIN}" \
            --state="${STATE_FILE}" \
            --socket="${SOCKET_FILE}" \
            --port=41641 \
            --tun=tailscale0 >>"${LOG}" 2>&1 </dev/null &
    else
        "${BIN}" \
            --state="${STATE_FILE}" \
            --socket="${SOCKET_FILE}" \
            --port=41641 \
            --tun=tailscale0 >>"${LOG}" 2>&1 </dev/null &
    fi
    sleep 1
    if [ -z "$(pids)" ]; then
        note "tailscaled exited. See ${LOG}."
        return 1
    fi
    expose_socket
}

# Apache runs index.cgi as the web user. tailscaled keeps its socket inside
# a root-only directory, so that user cannot open it and tailscale web exits
# before writing CGI headers. Apache then shows its "page not found" document.
expose_socket() {
    i=0
    while [ "${i}" -lt 10 ] && [ ! -S "${SOCKET_FILE}" ]; do
        i=$((i + 1))
        sleep 1
    done
    if [ -d "${STATE_DIR}" ]; then
        chmod 755 "${STATE_DIR}" 2>/dev/null || true
    fi
    if [ -S "${SOCKET_FILE}" ]; then
        chmod 666 "${SOCKET_FILE}" 2>/dev/null || true
    fi
}

# Username of the admin web server, when it is not root. tailscaled grants
# write access to that operator as well as to root.
cgi_user() {
    status=""
    for status in /proc/[0-9]*/status; do
        [ -r "${status}" ] || continue
        name=$(awk '/^Name:/ { print $2; exit }' "${status}" 2>/dev/null || true)
        case "${name}" in
        httpd|apache|apache2) ;;
        *) continue ;;
        esac
        uid=$(awk '/^Uid:/ { print $2; exit }' "${status}" 2>/dev/null || true)
        if [ -n "${uid}" ] && [ "${uid}" != "0" ]; then
            name=$(awk -F: -v id="${uid}" '$3 == id { print $1; exit }' /etc/passwd)
            if [ -n "${name}" ]; then
                printf '%s\n' "${name}"
                return 0
            fi
        fi
    done
    conf=""
    for conf in $(find /etc /usr/syno/etc /usr/syno/apache /usr/local/etc \
        \( -name 'httpd.conf' -o -name 'httpd.conf-*' \) 2>/dev/null || true); do
        name=$(awk '/^[[:space:]]*(User|SuexecUserGroup)[[:space:]]+/ && $2 != "root" { print $2; exit }' \
            "${conf}" 2>/dev/null || true)
        if [ -n "${name}" ]; then
            printf '%s\n' "${name}"
            return 0
        fi
    done
    return 1
}

grant_operator() {
    user=$(cgi_user || true)
    case "${user}" in
    ""|*[!A-Za-z0-9._-]*)
        note "Web server user not found."
        return 0
        ;;
    esac
    if ! "${PKGDEST}/bin/tailscale" --socket="${SOCKET_FILE}" set --operator="${user}" >>"${LOG}" 2>&1; then
        note "Could not grant ${user}. See ${LOG}."
    fi
}

# Tailscale's default after login points this host at 100.100.100.100.
# On a router, that replaces the router's own resolver. The preference
# survives login and is applied again on every start.
disable_dns() {
    if ! "${PKGDEST}/bin/tailscale" --socket="${SOCKET_FILE}" set --accept-dns=false >>"${LOG}" 2>&1; then
        note "Could not turn Tailscale DNS off. See ${LOG}."
    fi
}

# IPv4 forwarding has to be on before Tailscale will offer subnet routes.
# Writing the sysctl is enough on SRM; there is no sysctl.conf to persist,
# so this runs on every start. $1 overrides the path in tests.
enable_ip_forward() {
    forward_path=${1:-/proc/sys/net/ipv4/ip_forward}
    if [ ! -f "${forward_path}" ]; then
        return 0
    fi
    if ! printf '1\n' >"${forward_path}" 2>/dev/null; then
        note "Could not enable IPv4 forwarding."
    fi
}

# Print a comma-separated list of private IPv4 prefixes connected on this
# router, excluding the WAN (the interface with the default route) and
# interfaces that are not LANs. $1 is a /proc/net/route file. Addresses in
# that file are little-endian hex.
lan_routes_from_proc() {
    route_table=$1
    if [ ! -r "${route_table}" ]; then
        return 0
    fi
    awk '
        function hexval(s,    i, c, v) {
            v = 0
            s = tolower(s)
            for (i = 1; i <= length(s); i++) {
                c = substr(s, i, 1)
                v = v * 16 + index("0123456789abcdef", c) - 1
            }
            return v
        }
        # Byte values only. A mask such as 255.255.255.0 is larger than a
        # signed 32-bit integer, and BusyBox awk on this router truncates
        # those, which made every LAN prefix look invalid.
        function octet(h, pair) {
            if (pair == 1) return hexval(substr(h, 7, 2))
            if (pair == 2) return hexval(substr(h, 5, 2))
            if (pair == 3) return hexval(substr(h, 3, 2))
            return hexval(substr(h, 1, 2))
        }
        function dotted(h) {
            return octet(h, 1) "." octet(h, 2) "." octet(h, 3) "." octet(h, 4)
        }
        function prefixlen(h,    pair, n, b, bit, seen, bits) {
            seen = 0
            bits = 0
            for (pair = 4; pair >= 1; pair--) {
                n = octet(h, pair)
                for (b = 0; b < 8; b++) {
                    bit = int(n) % 2
                    n = int(n / 2)
                    if (bit == 1) {
                        seen = 1
                        bits++
                    } else if (seen) {
                        return -1
                    }
                }
            }
            if (bits <= 0 || bits >= 32) return -1
            return bits
        }
        function is_private(h,    o1, o2) {
            o1 = octet(h, 1)
            o2 = octet(h, 2)
            if (o1 == 10 || (o1 == 192 && o2 == 168)) return 1
            if (o1 == 172 && o2 >= 16 && o2 <= 31) return 1
            if (o1 == 100 && o2 >= 64 && o2 <= 127) return 1
            return 0
        }
        function has_prefix(s, p) {
            return substr(s, 1, length(p)) == p
        }
        function skip_iface(name) {
            if (name == "lo") return 1
            if (has_prefix(name, "tailscale")) return 1
            if (has_prefix(name, "docker")) return 1
            if (has_prefix(name, "veth")) return 1
            if (has_prefix(name, "sit")) return 1
            if (has_prefix(name, "ip6tnl")) return 1
            if (has_prefix(name, "ifb")) return 1
            if (has_prefix(name, "dummy")) return 1
            if (has_prefix(name, "teql")) return 1
            if (has_prefix(name, "gre")) return 1
            if (has_prefix(name, "erspan")) return 1
            return 0
        }
        function ishex8(s,    i, c) {
            if (length(s) != 8) return 0
            s = tolower(s)
            for (i = 1; i <= 8; i++) {
                c = substr(s, i, 1)
                if (index("0123456789abcdef", c) == 0) return 0
            }
            return 1
        }
        NF < 8 || !ishex8($2) || !ishex8($3) || !ishex8($8) { next }
        {
            n++
            iface[n] = $1
            dest[n] = $2
            gw[n] = $3
            flags[n] = $4
            mask[n] = $8
            if ($2 == "00000000" && $3 != "00000000") wan[$1] = 1
        }
        END {
            for (i = 1; i <= n; i++) {
                if (wan[iface[i]] || skip_iface(iface[i])) continue
                if (gw[i] != "00000000" || dest[i] == "00000000") continue
                if (int(hexval(flags[i])) % 2 == 0) continue
                plen = prefixlen(mask[i])
                if (plen < 0 || !is_private(dest[i])) continue
                cidr = dotted(dest[i]) "/" plen
                if (seen[cidr]++) continue
                routes[++nr] = cidr
            }
            for (i = 1; i <= nr; i++) {
                for (j = i + 1; j <= nr; j++) {
                    if (routes[j] < routes[i]) {
                        tmp = routes[i]
                        routes[i] = routes[j]
                        routes[j] = tmp
                    }
                }
            }
            out = ""
            for (i = 1; i <= nr; i++) out = out (out ? "," : "") routes[i]
            if (out != "") print out
        }
    ' "${route_table}"
}

# $1 is a file of prefixes separated by commas or whitespace.
read_route_list() {
    tr '[:space:],' ',' <"$1" | tr -s ',' | sed 's/^,//; s/,$//'
}

# Offer this router's LANs to the tailnet. An admin still has to approve
# them. Tailscale on Synology forwards the approved routes in userspace, so
# this does not install iptables rules.
#
# /var/packages/Tailscale/var/advertise-routes, when present, is the list to
# offer (empty means offer none). Without that file, connected private IPv4
# routes are used. Finding none leaves whatever is already advertised.
advertise_routes() {
    route_file="${STATE_DIR}/advertise-routes"
    if [ -f "${route_file}" ]; then
        adv_routes=$(read_route_list "${route_file}")
    else
        adv_routes=$(lan_routes_from_proc "${ROUTE_TABLE:-/proc/net/route}" 2>>"${LOG}") || adv_routes=""
        if [ -z "${adv_routes}" ]; then
            printf '%s\n' "$(date) no LAN routes detected" >>"${LOG}"
            return 0
        fi
    fi
    printf '%s\n' "$(date) advertising routes: ${adv_routes}" >>"${LOG}"
    if ! "${PKGDEST}/bin/tailscale" --socket="${SOCKET_FILE}" set --advertise-routes="${adv_routes}" >>"${LOG}" 2>&1; then
        note "Could not advertise routes. See ${LOG}."
    fi
}

# SRM replaces /var/packages/Tailscale/var on upgrade. /usr/syno/etc/packages
# is left in place, so the node key is kept there as well as in the upgrade
# scratch directory Package Center passes to preupgrade and postupgrade.
package_etc_dir() {
    if [ -n "${STATE_BACKUP_DIR:-}" ]; then
        printf '%s\n' "${STATE_BACKUP_DIR}"
        return 0
    fi
    printf '%s\n' "/usr/syno/etc/packages/${SYNOPKG_PKGNAME}"
}

backup_state() {
    if [ ! -s "${STATE_FILE}" ]; then
        return 0
    fi
    if [ -n "${SYNOPKG_TEMP_UPGRADE_FOLDER:-}" ]; then
        cp -f "${STATE_FILE}" "${SYNOPKG_TEMP_UPGRADE_FOLDER}/tailscaled.state" || true
    fi
    etc_dir=$(package_etc_dir)
    mkdir -p "${etc_dir}" 2>/dev/null || true
    if [ -d "${etc_dir}" ]; then
        cp -f "${STATE_FILE}" "${etc_dir}/tailscaled.state" || true
        chmod 600 "${etc_dir}/tailscaled.state" 2>/dev/null || true
    fi
}

restore_state() {
    if [ -s "${STATE_FILE}" ]; then
        return 0
    fi
    src=""
    if [ -n "${SYNOPKG_TEMP_UPGRADE_FOLDER:-}" ] && [ -s "${SYNOPKG_TEMP_UPGRADE_FOLDER}/tailscaled.state" ]; then
        src="${SYNOPKG_TEMP_UPGRADE_FOLDER}/tailscaled.state"
    else
        etc_dir=$(package_etc_dir)
        if [ -s "${etc_dir}/tailscaled.state" ]; then
            src="${etc_dir}/tailscaled.state"
        fi
    fi
    if [ -z "${src}" ]; then
        return 0
    fi
    mkdir -p "${STATE_DIR}"
    if ! cp -f "${src}" "${STATE_FILE}"; then
        note "Could not restore Tailscale state."
        return 0
    fi
    chmod 600 "${STATE_FILE}" 2>/dev/null || true
}

node_is_up() {
    "${PKGDEST}/bin/tailscale" --socket="${SOCKET_FILE}" status >/dev/null 2>&1
}

# Route advertisement at the moment of start is too early: an upgrade drops
# the node key, and the menu login that follows replaces prefs. Wait until
# the node is actually up, then offer the LANs.
ensure_routes() {
    if node_is_up; then
        advertise_routes
        backup_state
        return 0
    fi
    printf '%s\n' "$(date) waiting to advertise routes until Tailscale is logged in" >>"${LOG}"
    if command -v setsid >/dev/null 2>&1; then
        setsid "$0" advertise-routes >>"${LOG}" 2>&1 </dev/null &
    else
        "$0" advertise-routes >>"${LOG}" 2>&1 </dev/null &
    fi
}

wait_and_advertise() {
    attempt=0
    while [ "${attempt}" -lt "${ADVERTISE_ATTEMPTS:-150}" ]; do
        if node_is_up; then
            advertise_routes
            backup_state
            return 0
        fi
        attempt=$((attempt + 1))
        sleep "${ADVERTISE_INTERVAL:-2}"
    done
    printf '%s\n' "$(date) gave up advertising routes; Tailscale did not log in" >>"${LOG}"
}

publish_ui() {
    mkdir -p "${UI_ROOT}"
    if [ -L "${UI_LINK}" ]; then
        rm -f "${UI_LINK}"
    fi
    mkdir -p "${UI_LINK}"
    cp -f "${PKGDEST}/ui/config" "${PKGDEST}/ui/index.cgi" "${UI_LINK}/"
    # synohdpack resolves the icon and only serves one whose real path is
    # inside the package directory. DownloadStation is a symlink to target/ui
    # for that reason. A copied PNG under webman/3rdparty is rejected and the
    # menu shows the 1x1 error image. index.cgi stays a real file because
    # Apache on SRM does not execute CGI through a symlink.
    rm -f "${UI_LINK}/PACKAGE_ICON_256.PNG"
    ln -s "${PKGDEST}/ui/PACKAGE_ICON_256.PNG" "${UI_LINK}/PACKAGE_ICON_256.PNG"
    chown 0:0 "${UI_LINK}/index.cgi"
    chmod 4755 "${UI_LINK}/index.cgi"
}

unpublish_ui() {
    if [ -L "${UI_LINK}" ]; then
        rm -f "${UI_LINK}"
    elif [ -d "${UI_LINK}" ]; then
        rm -rf "${UI_LINK}"
    fi
}

stop_daemon() {
    current="$(pids)"
    if [ -z "${current}" ]; then
        return 0
    fi
    # shellcheck disable=SC2086
    kill ${current} 2>/dev/null || true
    i=0
    while [ "${i}" -lt 20 ]; do
        current="$(pids)"
        [ -z "${current}" ] && return 0
        i=$((i + 1))
        sleep 1
    done
    # shellcheck disable=SC2086
    kill -9 ${current} 2>/dev/null || true
    sleep 1
    current="$(pids)"
    if [ -n "${current}" ]; then
        note "tailscaled did not stop."
        return 1
    fi
}

main() {
    case "${1:-}" in
    start)
        restore_state
        publish_ui
        enable_ip_forward
        if [ -n "$(pids)" ]; then
            expose_socket
            grant_operator
            disable_dns
            ensure_routes
            return 0
        fi
        start_daemon
        grant_operator
        disable_dns
        ensure_routes
        ;;
    advertise-routes)
        wait_and_advertise
        ;;
    stop)
        backup_state
        stop_daemon
        unpublish_ui
        ;;
    status)
        if [ -n "$(pids)" ]; then
            return 0
        fi
        return 3
        ;;
    *)
        return 0
        ;;
    esac
}

if [ "${0##*/}" = "start-stop-status" ]; then
    main "$@"
fi

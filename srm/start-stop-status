#!/bin/sh
# Package Center calls this. On SRM 1.3.2 (BusyBox ps, RT2600ac) "ps aux"
# is an error and "ps w" is what lists the full command line.
set -eu

PKGDEST="${SYNOPKG_PKGDEST}"
# Outside target/, so a package upgrade does not replace it. The tailscale
# binary looks for its socket here when it is not running on DSM 6.
STATE_DIR="${SYNOPKG_PKGVAR:-/var/packages/${SYNOPKG_PKGNAME}/var}"
LOG="${STATE_DIR}/tailscaled.stdout.log"
BIN="${PKGDEST}/bin/tailscaled"
STATE_FILE="${STATE_DIR}/tailscaled.state"
SOCKET_FILE="${STATE_DIR}/tailscaled.sock"
# Apache on SRM serves this tree. Static files follow a symlink, but CGI is
# executed only from a real file here. DSM's nginx does the symlink itself.
UI_LINK="/usr/syno/synoman/webman/3rdparty/${SYNOPKG_PKGNAME}"

note() {
    printf '%s\n' "$1" >>"${SYNOPKG_TEMP_LOGFILE:-/dev/null}"
}

# pgrep is not installed on SRM. Which ps lists every process, and which
# column is the pid, was measured on SRM 1.3.2 BusyBox (RT2600ac): "ps aux"
# is an error there, and "ps" without "w" truncates the command line.
if ps aux >/dev/null 2>&1; then
    PS_CMD="ps aux"
    PS_COL=2
elif ps w >/dev/null 2>&1; then
    PS_CMD="ps w"
    PS_COL=1
else
    PS_CMD="ps"
    PS_COL=1
fi

pids() {
    # shellcheck disable=SC2009
    ${PS_CMD} 2>/dev/null | grep "${BIN}" | grep -v grep | awk -v col="${PS_COL}" '{print $col}' || true
}

ensure_tun() {
    ko=""
    for candidate in \
        /lib/modules/tun.ko \
        "/lib/modules/$(uname -r)/tun.ko" \
        "/lib/modules/$(uname -r)/kernel/drivers/net/tun.ko"
    do
        if [ -f "${candidate}" ]; then
            ko="${candidate}"
            break
        fi
    done
    if [ -n "${ko}" ]; then
        if ! lsmod 2>/dev/null | grep -q '^tun'; then
            insmod "${ko}" >/dev/null 2>&1 || true
        fi
    fi
    if [ ! -d /dev/net ]; then
        mkdir -m 755 /dev/net
    fi
    if [ ! -c /dev/net/tun ]; then
        mknod /dev/net/tun c 10 200
    fi
    chmod 666 /dev/net/tun
}

start_daemon() {
    mkdir -p "${STATE_DIR}"
    if ! ensure_tun 2>>"${LOG}"; then
        note "Could not create /dev/net/tun. See ${LOG}."
        return 1
    fi
    printf '%s\n' "$(date) starting ${BIN} --tun=tailscale0" >>"${LOG}"
    # New session, so Package Center exiting this script does not deliver SIGHUP.
    if command -v setsid >/dev/null 2>&1; then
        setsid "${BIN}" \
            --state="${STATE_FILE}" \
            --socket="${SOCKET_FILE}" \
            --port=41641 \
            --tun=tailscale0 >>"${LOG}" 2>&1 </dev/null &
    else
        "${BIN}" \
            --state="${STATE_FILE}" \
            --socket="${SOCKET_FILE}" \
            --port=41641 \
            --tun=tailscale0 >>"${LOG}" 2>&1 </dev/null &
    fi
    sleep 1
    if [ -z "$(pids)" ]; then
        note "tailscaled exited. See ${LOG}."
        return 1
    fi
    expose_socket
}

# Apache runs index.cgi as the web user. tailscaled keeps its socket inside
# a root-only directory, so that user cannot open it and tailscale web exits
# before writing CGI headers. Apache then shows its "page not found" document.
expose_socket() {
    i=0
    while [ "${i}" -lt 10 ] && [ ! -S "${SOCKET_FILE}" ]; do
        i=$((i + 1))
        sleep 1
    done
    if [ -d "${STATE_DIR}" ]; then
        chmod 755 "${STATE_DIR}" 2>/dev/null || true
    fi
    if [ -S "${SOCKET_FILE}" ]; then
        chmod 666 "${SOCKET_FILE}" 2>/dev/null || true
    fi
}

# Username of the admin web server, when it is not root. tailscaled grants
# write access to that operator as well as to root.
cgi_user() {
    status=""
    for status in /proc/[0-9]*/status; do
        [ -r "${status}" ] || continue
        name=$(awk '/^Name:/ { print $2; exit }' "${status}" 2>/dev/null || true)
        case "${name}" in
        httpd|apache|apache2) ;;
        *) continue ;;
        esac
        uid=$(awk '/^Uid:/ { print $2; exit }' "${status}" 2>/dev/null || true)
        if [ -n "${uid}" ] && [ "${uid}" != "0" ]; then
            name=$(awk -F: -v id="${uid}" '$3 == id { print $1; exit }' /etc/passwd)
            if [ -n "${name}" ]; then
                printf '%s\n' "${name}"
                return 0
            fi
        fi
    done
    conf=""
    for conf in $(find /etc /usr/syno/etc /usr/syno/apache /usr/local/etc \
        \( -name 'httpd.conf' -o -name 'httpd.conf-*' \) 2>/dev/null || true); do
        name=$(awk '/^[[:space:]]*(User|SuexecUserGroup)[[:space:]]+/ && $2 != "root" { print $2; exit }' \
            "${conf}" 2>/dev/null || true)
        if [ -n "${name}" ]; then
            printf '%s\n' "${name}"
            return 0
        fi
    done
    return 1
}

grant_operator() {
    user=$(cgi_user || true)
    case "${user}" in
    ""|*[!A-Za-z0-9._-]*)
        note "Web server user not found."
        return 0
        ;;
    esac
    note "Allowing ${user} to operate tailscaled."
    if ! "${PKGDEST}/bin/tailscale" --socket="${SOCKET_FILE}" set --operator="${user}" >>"${LOG}" 2>&1; then
        note "Could not grant ${user}. See ${LOG}."
    fi
}

publish_ui() {
    mkdir -p /usr/syno/synoman/webman/3rdparty
    if [ -L "${UI_LINK}" ]; then
        rm -f "${UI_LINK}"
    fi
    mkdir -p "${UI_LINK}"
    cp -f "${PKGDEST}/ui/config" "${PKGDEST}/ui/PACKAGE_ICON_256.PNG" \
        "${PKGDEST}/ui/index.cgi" "${UI_LINK}/"
    chown 0:0 "${UI_LINK}/index.cgi"
    chmod 4755 "${UI_LINK}/index.cgi"
}

unpublish_ui() {
    if [ -L "${UI_LINK}" ]; then
        rm -f "${UI_LINK}"
    elif [ -d "${UI_LINK}" ]; then
        rm -rf "${UI_LINK}"
    fi
}

stop_daemon() {
    current="$(pids)"
    if [ -z "${current}" ]; then
        return 0
    fi
    # shellcheck disable=SC2086
    kill ${current} 2>/dev/null || true
    i=0
    while [ "${i}" -lt 20 ]; do
        current="$(pids)"
        [ -z "${current}" ] && return 0
        i=$((i + 1))
        sleep 1
    done
    # shellcheck disable=SC2086
    kill -9 ${current} 2>/dev/null || true
    sleep 1
    current="$(pids)"
    if [ -n "${current}" ]; then
        note "tailscaled did not stop."
        return 1
    fi
}

case "${1:-}" in
start)
    publish_ui
    if [ -n "$(pids)" ]; then
        expose_socket
        grant_operator
        exit 0
    fi
    start_daemon
    grant_operator
    ;;
stop)
    stop_daemon
    unpublish_ui
    ;;
status)
    if [ -n "$(pids)" ]; then
        exit 0
    fi
    exit 3
    ;;
*)
    exit 0
    ;;
esac
